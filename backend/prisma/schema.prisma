// -----------------------------------------------------
// GENERATOR & DATASOURCE
// -----------------------------------------------------
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // chemin par défaut recommandé
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------
enum Role {
  admin
  etudiant
  membre_public
  personnel
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// -----------------------------------------------------
// UTILISATEURS
// -----------------------------------------------------
model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  prenom          String
  nom             String
  nin             String        @unique
  matricule       String?       @unique
  dateDeNaissance DateTime
  telephone       String
  passwordHash    String
  role            Role
  status          UserStatus    @default(ACTIVE)
  emprunts        Emprunt[]
  reservations    Reservation[]
  notifications   Notification[]
  notificationPrefs Json?
  createdAt       DateTime      @default(now())
}

// -----------------------------------------------------
// TABLES POUR LA RECHERCHE AVANCÉE
// -----------------------------------------------------

// Catégories (Informatique, Roman, Science...)
model Category {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  livres Livre[]
}

// Éditeur (O’Reilly, Dunod...)
model Editor {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  livres Livre[]
}

// Auteurs (plusieurs auteurs par livre)
model Author {
  id     Int          @id @default(autoincrement())
  nom    String
  prenom String
  livres LivreAuteur[]
}

// Pivot Livre <-> Auteur
model LivreAuteur {
  livreId  Int
  authorId Int

  livre   Livre  @relation(fields: [livreId], references: [id])
  author  Author @relation(fields: [authorId], references: [id])

  @@id([livreId, authorId])
}

// -----------------------------------------------------
// LIVRES & EXEMPLAIRES
// -----------------------------------------------------
model Livre {
  id               Int            @id @default(autoincrement())
  titre            String
  description      String?
  isbn             String         @unique
  anneePublication Int?
  langue           String?
  imageUrl         String?

  // relations avancées
  categoryId Int
  editorId   Int

  category       Category       @relation(fields: [categoryId], references: [id])
  editor         Editor         @relation(fields: [editorId], references: [id])
  auteurs        LivreAuteur[]

  // Gestion par compteurs
  stockTotal     Int            @default(0)
  stockDisponible Int           @default(0)
  reservedCount  Int            @default(0)
  borrowedCount  Int            @default(0)

  emprunts       Emprunt[]
  reservations   Reservation[]

  createdAt      DateTime       @default(now())
}

// Exemplaires supprimés: gestion par compteurs sur Livre

// -----------------------------------------------------
// EMPRUNTS
// -----------------------------------------------------
model Emprunt {
  id             Int        @id @default(autoincrement())
  userId         Int
  livreId        Int

  user           User       @relation(fields: [userId], references: [id])
  livre          Livre      @relation(fields: [livreId], references: [id])

  dateEmprunt    DateTime   @default(now())
  // Due date (expected return date)
  dateRetour     DateTime?
  // Actual return timestamp
  returnedAt     DateTime?
  renouvellement Int        @default(0)
  createdAt      DateTime   @default(now())
}

// -----------------------------------------------------
// RÉSERVATIONS
// -----------------------------------------------------
model Reservation {
  id              Int        @id @default(autoincrement())
  userId          Int
  livreId         Int

  user            User       @relation(fields: [userId], references: [id])
  livre           Livre      @relation(fields: [livreId], references: [id])

  // Start date when reservation becomes active / eligible (selected by student)
  dateReservation DateTime   @default(now())
  // Due date / expiration for pickup window (optional)
  dateReservationDue DateTime?
  statut          String      @default("en_attente")
  createdAt       DateTime   @default(now())
}

// -----------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------
model Notification {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  readAt    DateTime?

  // Either a direct recipient (most cases) ...
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // ...or a role-targeted notification (used for admin pseudo-account)
  roleTarget Role?

  type      String
  title     String
  message   String
  href      String?

  // Prevent duplicates across cron runs & event hooks
  dedupeKey String @unique

  @@index([userId, createdAt])
  @@index([roleTarget, createdAt])
}
